# Langfuse (self-hosted)
YTFLOW_LANGFUSE_HOST=https://langfuse.your-host.com
YTFLOW_LANGFUSE_PUBLIC_KEY=pk-lf-...
YTFLOW_LANGFUSE_SECRET_KEY=sk-lf-...

# DeepSeek V4 (OpenAI-compatible) — planning side of the Story 12.2 model split:
# research / structure / cast_decision / visual_breakdown / tts_normalize.
YTFLOW_DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
YTFLOW_DEEPSEEK_BASE_URL=https://api.deepseek.com/
YTFLOW_DEEPSEEK_MODEL=deepseek-v4-flash
# 코드 기본값 16384. 운영 유닛(ytflow-api)은 ExecStart에서 32768로 덮어쓴다.
YTFLOW_DEEPSEEK_MAX_TOKENS=16384

# Gemini (OpenAI-compatibility endpoint) — prose side of the Story 12.2 model split:
# scenario writing + scene repair, runtime review/critic, and the Epic 4 A/B judge.
# Use a restricted/authorized key from secret storage, never an unrestricted standard
# key (Google rejects those from September 2026). Pin exact stable model IDs, not
# `-latest` or preview aliases.
YTFLOW_GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
YTFLOW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# WRITING_* serves every scenario-chain stage Gemini owns — writing, scene repair,
# and the runtime review/critic judges (one shared seam). JUDGE_* serves the Epic 4
# A/B judge only, so raising JUDGE_MODEL does NOT change runtime review/critic.
YTFLOW_GEMINI_WRITING_MODEL=gemini-3.6-flash
YTFLOW_GEMINI_JUDGE_MODEL=gemini-3.6-flash
YTFLOW_GEMINI_WRITING_MAX_TOKENS=16384
YTFLOW_GEMINI_JUDGE_MAX_TOKENS=8192

# Qwen TTS (DashScope international)
YTFLOW_QWEN_TTS_API_KEY=<YOUR_QWEN_TTS_API_KEY>
YTFLOW_QWEN_TTS_ENDPOINT=https://dashscope-intl.aliyuncs.com
YTFLOW_QWEN_TTS_MODEL=qwen3-tts-flash
YTFLOW_QWEN_TTS_VOICE=Cherry
YTFLOW_QWEN_TTS_CLONE_ENABLED=false
YTFLOW_QWEN_TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22
YTFLOW_QWEN_TTS_CLONE_VOICE_PATH=data/voices/sutak.mp3
YTFLOW_QWEN_TTS_CLONE_VOICE_ID=
YTFLOW_QWEN_TTS_SPEED=1.2
# Set true to write deterministic local silent WAVs instead of calling the cloud API.
YTFLOW_QWEN_TTS_MOCK=false

# Runtime artifact root (stage nodes write under {workspace}/{run_id}/).
YTFLOW_WORKSPACE_PATH=./workspace

# Asset library root (character cards, location plates, look-dev anchors) —
# separate from workspace/ so run cleanup never touches library assets.
YTFLOW_ASSETS_PATH=./assets
YTFLOW_STYLE_EPOCH=1

# ComfyUI (local)
YTFLOW_COMFYUI_URL=http://localhost:8188
YTFLOW_COMFYUI_MOCK=false
YTFLOW_COMFYUI_WORKFLOW_PATH=data/workflows/comfyui_sdxl_anime_lora_workflow_api2.json

# Character card sprite generation (portrait RGBA sprites).
YTFLOW_CHARACTER_IMAGE_WIDTH=832
YTFLOW_CHARACTER_IMAGE_HEIGHT=1216
# Maximum new on-demand special-pose cards generated when approving a scenario gate.
YTFLOW_SPECIAL_POSE_MAX_PER_RUN=3
# 캐릭터 카드 자동 판독(비전) 키. 비면 해당 경로만 비활성, 런은 계속된다.
YTFLOW_CHARACTER_VISION_API_KEY=<YOUR_VISION_API_KEY>

# Sound design (Story 7.1) — BGM/ambient/stinger mixed under narration. Opt out
# (false) if data/audio/{bgm,ambient,sfx} hasn't been populated yet.
YTFLOW_SOUND_DESIGN_ENABLED=true

# Stock location plates (Story 8.5) — IPAdapter style-anchor weight for
# scripts/seed_location_plates.py. Anchor images live in the anchor dir below.
YTFLOW_LOCATION_IPADAPTER_WEIGHT=0.4
YTFLOW_LOCATION_PLATE_WORKFLOW_PATH=data/workflows/comfyui_location_plate_api.json
YTFLOW_LOCATION_ANCHOR_DIR=data/anchors/locations

# DB
YTFLOW_DB_PATH=yt_flow.db

# Subtitle alignment
YTFLOW_ALIGNER=whisperx

# E2E (Playwright) — target the FastAPI-served build, not the Vite dev server
PORT=8000
BASE_URL=http://127.0.0.1:8000
