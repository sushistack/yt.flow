{
  "model": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "ytflow:pose_model" },
    "inputs": { "unet_name": "qwen-image-edit-2511-Q4_K_M.gguf" }
  },
  "shift": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "ytflow:pose_model_sampling" },
    "inputs": { "model": ["model", 0], "shift": 3.1 }
  },
  "cfgnorm": {
    "class_type": "CFGNorm",
    "_meta": { "title": "ytflow:pose_cfg_norm" },
    "inputs": { "model": ["shift", 0], "strength": 1.0 }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "ytflow:pose_text_encoder" },
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "_meta": { "title": "ytflow:pose_vae" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "reference": {
    "class_type": "LoadImage",
    "_meta": { "title": "ytflow:reference_image" },
    "inputs": { "image": "PLACEHOLDER_REFERENCE.png" }
  },
  "guide": {
    "class_type": "LoadImage",
    "_meta": { "title": "ytflow:guide_image" },
    "inputs": { "image": "PLACEHOLDER_GUIDE.png" }
  },
  "positive": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "ytflow:positive_prompt" },
    "inputs": {
      "clip": ["clip", 0],
      "prompt": "PLACEHOLDER_ACTION_INSTRUCTION",
      "vae": ["vae", 0],
      "image1": ["reference", 0],
      "image2": ["guide", 0]
    }
  },
  "negative": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "ytflow:negative_prompt" },
    "inputs": {
      "clip": ["clip", 0],
      "prompt": "",
      "vae": ["vae", 0]
    }
  },
  "positive_ref": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "ytflow:pose_positive_reference_method" },
    "inputs": { "conditioning": ["positive", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "negative_ref": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "ytflow:pose_negative_reference_method" },
    "inputs": { "conditioning": ["negative", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "latent": {
    "class_type": "VAEEncode",
    "_meta": { "title": "ytflow:pose_latent" },
    "inputs": { "pixels": ["reference", 0], "vae": ["vae", 0] }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": { "title": "ytflow:sampler" },
    "inputs": {
      "model": ["cfgnorm", 0],
      "positive": ["positive_ref", 0],
      "negative": ["negative_ref", 0],
      "latent_image": ["latent", 0],
      "seed": 0,
      "steps": 40,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": { "title": "ytflow:pose_decode" },
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "cutout": {
    "class_type": "InspyrenetRembg",
    "_meta": { "title": "ytflow:pose_cutout" },
    "inputs": { "image": ["decode", 0], "torchscript_jit": "default" }
  },
  "output": {
    "class_type": "SaveImage",
    "_meta": { "title": "ytflow:pose_output" },
    "inputs": { "images": ["cutout", 0], "filename_prefix": "ytflow_pose" }
  }
}
